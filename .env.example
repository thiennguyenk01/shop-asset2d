# Copy to .env.local and fill in locally. NEVER commit real values, never paste them into chat.
# Validated at startup by src/server/env.ts.

# development | test | preview | production  (VERCEL_ENV=production always forces production)
APP_ENV=development
APP_URL=http://localhost:3000

# --- Neon PostgreSQL (use the `dev` branch locally, never the production branch) ---
# Pooled connection (host contains "-pooler") — used by the app at runtime.
# Use sslmode=verify-full here (node-postgres will weaken "require" in its next major version).
DATABASE_URL=
# Direct connection (same host WITHOUT "-pooler") — used only by `npm run db:migrate`. Keep sslmode=require (Prisma CLI).
DIRECT_URL=
# Comma-separated production DB hosts; db:migrate / db:seed refuse to touch them.
PRODUCTION_DATABASE_HOSTS=
# Production database (GĐ7.4): its DIRECT_URL goes ONLY in a separate file `.env.production-db` (not here, not
# in .env.local), read by `npm run db:prod:status | db:prod:migrate | db:prod:reference` and nothing else.
# That file holds one line: DIRECT_URL=<direct connection of the Neon "production" branch, sslmode=require>.

# --- Auth.js --- generate with: npx auth secret   (min. 32 chars)
AUTH_SECRET=
# Only for `next start` outside Vercel (e.g. local production test): Auth.js must trust the Host header.
# Vercel and `next dev` trust it automatically; Playwright sets it for its own server.
# AUTH_TRUST_HOST=true
# "Continue with Google" (optional): OAuth client ID + secret from Google Cloud Console → APIs & Services →
# Credentials (type "Web application"). Authorized redirect URI: <APP_URL>/api/auth/callback/google
# (dev: http://localhost:3000/api/auth/callback/google). Both or neither; empty = the Google button is hidden.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payment --- demo | payos | vnpay | momo | sepay   (demo is refused in production; payos / vnpay not built yet)
PAYMENT_PROVIDER=demo

# --- MoMo (GĐ6.4, used when PAYMENT_PROVIDER=momo) --- wallet payments (QR / MoMo app).
# Test environment: https://test-payment.momo.vn (no real money; orders are marked Demo).
# Production must use https://payment.momo.vn. Take the keys from MoMo (test keys: MoMo's developer docs / your
# MoMo business account) and put them ONLY in .env.local — never in the repo, never in chat.
# MoMo must reach /api/payments/momo/webhook: on your machine, open the site through a Cloudflare quick tunnel
# (docs/OPERATIONS.md); the tunnel address is picked up from the request automatically.
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# --- SePay bank transfers (VietQR), used when PAYMENT_PROVIDER=sepay ---
# SEPAY_MODE=test: SePay Test mode (my.sepay.vn → Test mode): transfers are simulated, no money moves, orders are
# marked Demo. Production must use live. In SePay create a webhook (event: money in) pointing to
# <public address>/api/payments/sepay/webhook with authentication HMAC-SHA256; SePay shows the secret key once —
# put it ONLY in .env.local (never in the repo, never in chat). On your machine SePay reaches the site through a
# Cloudflare quick tunnel (docs/OPERATIONS.md). Bank account / bank short name (e.g. MBBank) / holder are those of
# the receiving account (in Test mode: the test account created in SePay).
SEPAY_MODE=test
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=

# --- Storage --- local (dev only, stored in .storage/ outside public/) | r2 (required in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage

# --- Cloudflare R2 (GĐ7.5; set STORAGE_DRIVER=r2 to use it) --- docs/OPERATIONS.md "Cloudflare R2"
# Account ID (32 hex) and an R2 API token with Object Read & Write on BOTH buckets. Two different buckets:
# PUBLIC = preview pictures / videos, PRIVATE = sellable files (never public). Check with `npm run storage:check`,
# copy the files of .storage/ with `npm run storage:push`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# https origin of the custom domain connected to the PUBLIC bucket (e.g. https://media.example.com); while testing,
# its https://pub-….r2.dev address (rate-limited, refused in production).
R2_PUBLIC_BASE_URL=

# --- Mail (GĐ6, GĐ7.7) --- outbox (dev: mails are written as files to MAIL_OUTBOX_DIR, never sent) | resend
# resend = the real service (Resend HTTP API, needs RESEND_API_KEY); outbox is refused in production; smtp is not
# implemented. Before the domain is verified at Resend, MAIL_FROM="… <onboarding@resend.dev>" only reaches the
# Resend account's own address (npm run mail:test -- <that address>). Production needs MAIL_FROM on the shop's domain.
MAIL_DRIVER=outbox
MAIL_OUTBOX_DIR=.mail-outbox
MAIL_FROM="Asset Game MMORPG 2D <no-reply@localhost>"
RESEND_API_KEY=

# --- Scheduled jobs (GĐ6.3) --- /api/cron/reconcile and /api/cron/cleanup answer only
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it). Required in production (32+ chars).
# In development run the jobs with: npm run cron:run
CRON_SECRET=
