# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
/frontend/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# prisma generated client
/backend/src/generated/

# local storage driver (dev only, holds sellable files — never commit, never under public/)
/.storage/

# playwright
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/

# dev mail outbox (GĐ6: mails are written here instead of being sent — contain reset links, never commit)
/.mail-outbox/

# local backups of docs / the tree (kept on the owner's machine only)
/.backup/

# Claude Code: per-machine settings (the shared rules in .claude/rules/ are committed)
/.claude/settings.local.json
