{
  "name": "asset-game-mmorpg-2d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev frontend",
    "build": "prisma generate --config backend/prisma.config.ts && next build frontend",
    "start": "next start frontend",
    "lint": "eslint",
    "typecheck": "next typegen frontend && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --config backend/vitest.config.mts && vitest run --config frontend/vitest.config.mts",
    "test:watch": "vitest --config backend/vitest.config.mts",
    "test:integration": "vitest run --config backend/vitest.integration.config.mts",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "i18n:check": "tsx frontend/scripts/i18n-check.ts",
    "db:generate": "prisma generate --config backend/prisma.config.ts",
    "db:migrate": "tsx backend/scripts/db-guard.ts migrate && prisma migrate dev --config backend/prisma.config.ts",
    "db:seed": "tsx backend/scripts/db-guard.ts seed && prisma db seed --config backend/prisma.config.ts",
    "db:seed:coupons": "tsx backend/scripts/db-guard.ts seed && prisma db seed --config backend/prisma.config.ts -- --only=coupons",
    "db:studio": "prisma studio --config backend/prisma.config.ts",
    "db:prod:status": "tsx backend/scripts/db-prod.ts status",
    "db:prod:migrate": "tsx backend/scripts/db-prod.ts migrate",
    "db:prod:reference": "tsx backend/scripts/db-prod.ts reference",
    "db:prod:grant": "tsx backend/scripts/db-prod.ts grant",
    "db:prod:revoke": "tsx backend/scripts/db-prod.ts revoke",
    "prod:init": "tsx backend/scripts/prod-env.ts init",
    "prod:check": "tsx backend/scripts/prod-env.ts check",
    "admin:grant": "tsx backend/scripts/admin-grant.ts grant",
    "admin:revoke": "tsx backend/scripts/admin-grant.ts revoke",
    "mail:preview": "tsx backend/scripts/mail-preview.ts",
    "cron:run": "tsx --conditions=react-server backend/scripts/cron.ts",
    "storage:check": "tsx backend/scripts/storage-check.ts",
    "storage:push": "tsx backend/scripts/storage-push.ts",
    "preview:init": "tsx backend/scripts/preview-env.ts init",
    "preview:setup": "tsx backend/scripts/preview-env.ts setup",
    "preview:check": "tsx backend/scripts/preview-env.ts check",
    "preview:grant": "tsx backend/scripts/preview-env.ts grant",
    "preview:revoke": "tsx backend/scripts/preview-env.ts revoke",
    "postinstall": "prisma generate --config backend/prisma.config.ts",
    "icons": "node frontend/scripts/generate-icons.mjs frontend frontend/src/app"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.15.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
