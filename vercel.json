{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/.next",
  "crons": [
    { "path": "/api/cron/reconcile", "schedule": "0 19 * * *" },
    { "path": "/api/cron/cleanup", "schedule": "30 19 * * *" }
  ]
}
